 .confetti { position: fixed; width: 10px; height: 10px; top: -12px; z-index: 50; pointer-events: none; animation: fall 1.6s ease-in forwards; }\n  @keyframes fall { to { transform: translateY(105vh) rotate(720deg); opacity: 0.6; } }\n\n  @media (max-width: 700px) { .products { grid-template-columns: 1fr; } }\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003cdiv class=\"shape s1\">\u003c/div>\u003cdiv class=\"shape s2\">\u003c/div>\u003cdiv class=\"shape s3\">\u003c/div>\u003cdiv class=\"shape s4\">\u003c/div>\u003cdiv class=\"shape s5\">\u003c/div>\n\n  \u003cdiv class=\"wrap\">\n    \u003cnav>\n      \u003cdiv class=\"logo\">\u003cspan class=\"candy\">🍬\u003c/span> SugarLab\u003c/div>\n      \u003cbutton class=\"cart\" id=\"cartBtn\">🛒 Cart \u003cspan class=\"badge\" id=\"cartCount\">0\u003c/span>\u003c/button>\n    \u003c/nav>\n\n    \u003cheader>\n      \u003ch1>Life is short.\u003cbr>Eat the \u003cspan class=\"c1\">rain\u003c/span>\u003cspan class=\"c2\">bow\u003c/span>\u003cspan class=\"c3\">.\u003c/span>\u003c/h1>\n      \u003cp class=\"sub\">Handmade candy with colours loud enough to hear. Cooked in small batches, shipped with love (and bubble wrap).\u003c/p>\n      \u003cbutton class=\"big-cta\" id=\"partyBtn\">🎉 Grab a bag!\u003c/button>\n    \u003c/header>\n\n    \u003cdiv class=\"products\">\n      \u003cdiv class=\"prod\">\u003cdiv class=\"face f1\">🍭\u003c/div>\u003ch3>Unicorn Swirl\u003c/h3>\u003cdiv class=\"desc\">strawberry + bubblegum swirl pop\u003c/div>\u003cdiv class=\"price\">RM 6.90\u003c/div>\u003cbutton class=\"add\">Add to cart\u003c/button>\u003c/div>\n      \u003cdiv class=\"prod\">\u003cdiv class=\"face f2\">🐸\u003c/div>\u003ch3>Gummy Frogs\u003c/h3>\u003cdiv class=\"desc\">sour lime frogs that stare back\u003c/div>\u003cdiv class=\"price\">RM 8.50\u003c/div>\u003cbutton class=\"add\">Add to cart\u003c/button>\u003c/div>\n      \u003cdiv class=\"prod\">\u003cdiv class=\"face f3\">🫐\u003c/div>\u003ch3>Galaxy Berries\u003c/h3>\u003cdiv class=\"desc\">blueberry clouds, zero gravity\u003c/div>\u003cdiv class=\"price\">RM 7.20\u003c/div>\u003cbutton class=\"add\">Add to cart\u003c/button>\u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"funline\">made with sugar, food colouring & questionable life choices 🍬\u003c/div>\n  \u003c/div>\n\n  \u003cscript>\n    // cart counter with bounce\n    let n = 0;\n    const badge = document.getElementById('cartCount'), cart = document.getElementById('cartBtn');\n    document.querySelectorAll('.add').forEach(b => b.addEventListener('click', () => {\n      n++;\n      badge.textContent = n;\n      cart.classList.remove('bounce');\n      void cart.offsetWidth;\n      cart.classList.add('bounce');\n      toast('Added to cart! 🍬');\n    }));\n    document.getElementById('cartBtn').addEventListener('click', () => toast(n ? 'You have ' + n + ' sweet(s) in the cart!' : 'Cart is empty — grab something!'));\n\n    // confetti burst\n    const colors = ['#ff6fb5', '#ffd93d', '#6bcb77', '#4d96ff', '#c780fa'];\n    function confetti(x, y) {\n      for (let i = 0; i \u003c 40; i++) {\n        const c = document.createElement('div');\n        c.className = 'confetti';\n        c.style.background = colors[i % colors.length];\n        c.style.left = (x + (Math.random() - 0.5) * 120) + 'px';\n        c.style.top = y + 'px';\n        c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';\n        c.style.animationDelay = (Math.random() * 0.2) + 's';\n        document.body.appendChild(c);\n        setTimeout(() => c.remove(), 2000);\n      }\n    }\n    document.getElementById('partyBtn').addEventListener('click', e => {\n      const r = e.target.getBoundingClientRect();\n      confetti(r.left + r.width / 2, r.top);\n      toast('YAAAY party time! 🎉');\n    });\n\n    // tiny toast\n    let tt;\n    function toast(m) {\n      let t = document.getElementById('toast');\n      if (!t) { t = document.createElement('div'); t.id = 'toast'; t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#3d2b3d;color:#fff;padding:10px 20px;border-radius:999px;font-size:13px;font-weight:600;z-index:60'; document.body.appendChild(t); }\n      t.textContent = m;\n      clearTimeout(tt);\n      tt = setTimeout(() => t.remove(), 1800);\n    }\n  \u003c/script>\n\u003c/body>\n\u003c/html>\n"}}