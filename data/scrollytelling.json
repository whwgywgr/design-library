r-spacing: -0.01em; }\n  .step p { color: #9aa0b4; font-size: 15px; line-height: 1.65; }\n  .step .tag { display: inline-block; margin-top: 16px; font-size: 11.5px; font-weight: 600; color: var(--c); background: rgba(255, 255, 255, 0.05); border: 1px solid var(--c); border-radius: 999px; padding: 4px 12px; }\n\n  .end { text-align: center; padding: 120px 24px 140px; }\n  .end h2 { font-size: clamp(26px, 4vw, 40px); letter-spacing: -0.02em; }\n  .end p { color: #8a90a5; margin-top: 10px; }\n  .end .btn { display: inline-block; margin-top: 26px; background: #e8eaf0; color: #0f1115; font-weight: 700; text-decoration: none; padding: 12px 26px; border-radius: 999px; }\n\n  @media (max-width: 780px) { .story { grid-template-columns: 1fr; } .visual { display: none; } .steps { gap: 12vh; padding-top: 8vh; } .step { opacity: 1; transform: none; } }\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003cdiv class=\"hero\">\n    \u003cdiv class=\"k\">A launch story · scroll to read\u003c/div>\n    \u003ch1>From a napkin sketch\u003cbr>to a million users\u003c/h1>\n    \u003cp>Four chapters. One sticky little planet that changes as you go.\u003c/p>\n    \u003cspan class=\"down\">↓\u003c/span>\n  \u003c/div>\n\n  \u003cdiv class=\"story\" id=\"story\">\n    \u003cdiv class=\"visual\" id=\"visual\">\n      \u003cdiv class=\"blob\" id=\"blob\">✳\u003c/div>\n      \u003cdiv class=\"vcap\">\n        \u003cdiv class=\"vnum\" id=\"vnum\">CHAPTER 1\u003c/div>\n        \u003cdiv class=\"vtitle\" id=\"vtitle\">The Idea\u003c/div>\n      \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"steps\">\n      \u003cdiv class=\"step on\" data-c=\"#6366f1\" data-n=\"CHAPTER 1\" data-t=\"The Idea\" data-g=\"✳\">\n        \u003cdiv class=\"n\">CHAPTER 1\u003c/div>\n        \u003ch2>The Idea\u003c/h2>\n        \u003cp>Every product starts as a complaint. Ours was: why does tracking a team's week take eleven tabs and a spreadsheet nobody trusts?\u003c/p>\n        \u003cspan class=\"tag\">2 friends · 1 whiteboard\u003c/span>\n      \u003c/div>\n      \u003cdiv class=\"step\" data-c=\"#06b6d4\" data-n=\"CHAPTER 2\" data-t=\"The Build\" data-g=\"◆\">\n        \u003cdiv class=\"n\">CHAPTER 2\u003c/div>\n        \u003ch2>The Build\u003c/h2>\n        \u003cp>Ninety days of prototypes. We shipped the boring parts first — sync, offline, keyboard shortcuts — and let the polish accumulate like interest.\u003c/p>\n        \u003cspan class=\"tag\">v0.1 → v0.9 in one quarter\u003c/span>\n      \u003c/div>\n      \u003cdiv class=\"step\" data-c=\"#f59e0b\" data-n=\"CHAPTER 3\" data-t=\"The Launch\" data-g=\"▲\">\n        \u003cdiv class=\"n\">CHAPTER 3\u003c/div>\n        \u003ch2>The Launch\u003c/h2>\n        \u003cp>We posted it on a Tuesday morning with a two-sentence demo. By dinner it had 40,000 visitors and one very warm server.\u003c/p>\n        \u003cspan class=\"tag\">#1 product of the day\u003c/span>\n      \u003c/div>\n      \u003cdiv class=\"step\" data-c=\"#22c55e\" data-n=\"CHAPTER 4\" data-t=\"The Growth\" data-g=\"●\">\n        \u003cdiv class=\"n\">CHAPTER 4\u003c/div>\n        \u003ch2>The Growth\u003c/h2>\n        \u003cp>Growth turned out to be the quiet part: answer every email, ship every Tuesday, and never charge for the thing that makes people love you.\u003c/p>\n        \u003cspan class=\"tag\">1,000,000 users and counting\u003c/span>\n      \u003c/div>\n    \u003c/div>\n  \u003c/div>\n\n  \u003cdiv class=\"end\">\n    \u003ch2>Your chapter goes here.\u003c/h2>\n    \u003cp>Swap the copy, keep the machinery — four steps, one sticky visual, endless stories.\u003c/p>\n    \u003ca class=\"btn\" href=\"#\">Start your story\u003c/a>\n  \u003c/div>\n\n  \u003cscript>\n    const steps = document.querySelectorAll('.step');\n    const blob = document.getElementById('blob');\n    const vnum = document.getElementById('vnum');\n    const vtitle = document.getElementById('vtitle');\n    const visual = document.getElementById('visual');\n    const io = new IntersectionObserver(es => {\n      es.forEach(e => {\n        if (!e.isIntersecting) return;\n        steps.forEach(s => s.classList.remove('on'));\n        e.target.classList.add('on');\n        const c = e.target.dataset.c;\n        visual.style.setProperty('--c', c);\n        blob.textContent = e.target.dataset.g;\n        vnum.textContent = e.target.dataset.n;\n        vtitle.textContent = e.target.dataset.t;\n      });\n    }, { rootMargin: '-40% 0px -40% 0px' });\n    steps.forEach(s => io.observe(s));\n  \u003c/script>\n\u003c/body>\n\u003c/html>\n"}}