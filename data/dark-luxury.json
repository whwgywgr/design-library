height: 1.8; }\n  .hero-cta { display: inline-block; border: 1px solid #c9a227; color: #e8d9a0; text-decoration: none; font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; padding: 14px 34px; transition: all 0.25s; }\n  .hero-cta:hover { background: #c9a227; color: #0a0a0a; }\n\n  .products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; padding: 20px 0 60px; position: relative; }\n  .prod { border: 1px solid rgba(201, 162, 39, 0.35); padding: 40px 26px 34px; text-align: center; position: relative; overflow: hidden; transition: border-color 0.3s; }\n  .prod:hover { border-color: #c9a227; }\n  .prod .glow { position: absolute; inset: 0; background: radial-gradient(220px 220px at var(--mx, 50%) var(--my, 50%), rgba(201, 162, 39, 0.16), transparent 70%); opacity: 0; transition: opacity 0.3s; pointer-events: none; }\n  .prod:hover .glow { opacity: 1; }\n  .prod .no { font-family: Georgia, serif; font-size: 40px; color: #c9a227; margin-bottom: 14px; }\n  .prod h3 { font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 500; margin-bottom: 10px; }\n  .prod p { font-size: 13px; color: #8a8578; line-height: 1.75; margin-bottom: 18px; }\n  .prod .price { font-family: Georgia, serif; font-size: 16px; color: #e8d9a0; }\n\n  .quote { border-top: 1px solid rgba(201, 162, 39, 0.45); border-bottom: 1px solid rgba(201, 162, 39, 0.45); padding: 60px 30px; text-align: center; margin: 20px 0 60px; }\n  .quote p { font-family: Georgia, serif; font-style: italic; font-size: clamp(20px, 3.4vw, 28px); line-height: 1.55; color: #e8d9a0; max-width: 640px; margin: 0 auto; }\n  .quote .by { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #8a8578; margin-top: 20px; }\n\n  footer { border-top: 1px solid rgba(201, 162, 39, 0.45); padding: 26px 0 44px; text-align: center; font-size: 10.5px; letter-spacing: 0.3em; text-transform: uppercase; color: #8a8578; }\n  footer .g { color: #c9a227; }\n\n  @media (max-width: 740px) { .products { grid-template-columns: 1fr; } nav .links { display: none; } }\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003cdiv class=\"wrap\">\n    \u003cnav>\n      \u003cdiv class=\"maison\">MAISON NOIR\u003c/div>\n      \u003cdiv class=\"links\">\u003ca href=\"#\">Collection\u003c/a>\u003ca href=\"#\">Atelier\u003c/a>\u003ca href=\"#\">Maison\u003c/a>\u003ca href=\"#\">Contact\u003c/a>\u003c/div>\n    \u003c/nav>\n\n    \u003cheader>\n      \u003cdiv class=\"est\">Maison Noir · Paris · Est. 1931\u003c/div>\n      \u003ch1>The art of less,\u003cbr>\u003cem>finished in gold.\u003c/em>\u003c/h1>\n      \u003cdiv class=\"divider\">\u003c/div>\n      \u003cp class=\"hero-p\">Ninety-five years of quiet obsession — objects made slowly, in black and gold, for the few who understand why there is no logo.\u003c/p>\n      \u003ca class=\"hero-cta\" href=\"#\">Discover the collection\u003c/a>\n    \u003c/header>\n\n    \u003cdiv class=\"products\" id=\"products\">\n      \u003cdiv class=\"prod\">\u003cdiv class=\"glow\">\u003c/div>\u003cdiv class=\"no\">N°1\u003c/div>\u003ch3>Noir Absolu\u003c/h3>\u003cp>Extrait de parfum. Smoked vetiver, black orchid, a whisper of amber that lasts three days on silk.\u003c/p>\u003cdiv class=\"price\">RM 1,290\u003c/div>\u003c/div>\n      \u003cdiv class=\"prod\">\u003cdiv class=\"glow\">\u003c/div>\u003cdiv class=\"no\">N°2\u003c/div>\u003ch3>Heure d'Or\u003c/h3>\u003cp>Hand-finished timepiece. 38mm case in blackened steel, champagne dial, one gold hand for the hour that matters.\u003c/p>\u003cdiv class=\"price\">RM 18,500\u003c/div>\u003c/div>\n      \u003cdiv class=\"prod\">\u003cdiv class=\"glow\">\u003c/div>\u003cdiv class=\"no\">N°3\u003c/div>\u003ch3>Cahier Noir\u003c/h3>\u003cp>Notebook in full-grain calfskin. 240 pages of cotton paper, gilded edges, and nothing written — yet.\u003c/p>\u003cdiv class=\"price\">RM 480\u003c/div>\u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"quote\">\n      \u003cp>“Luxury is not the price tag. It is the silence of a thing so well made that it never needs to speak.”\u003c/p>\n      \u003cdiv class=\"by\">— Henri Noir, founder\u003c/div>\n    \u003c/div>\n  \u003c/div>\n\n  \u003cfooter>\u003cdiv class=\"wrap\">\u003cspan>Maison Noir \u003cspan class=\"g\">◆\u003c/span> Paris — Kuala Lumpur\u003c/span>\u003c/div>\u003c/footer>\n\n  \u003cscript>\n    // cursor-following golden glow on each product card\n    document.querySelectorAll(\".prod\").forEach(card => {\n      card.addEventListener(\"pointermove\", e => {\n        const r = card.getBoundingClientRect();\n        card.querySelector(\".glow\").style.setProperty(\"--mx\", (e.clientX - r.left) + \"px\");\n        card.querySelector(\".glow\").style.setProperty(\"--my\", (e.clientY - r.top) + \"px\");\n      });\n    });\n    // quiet fade-in on scroll\n    const io = new IntersectionObserver(es => es.forEach(en => {\n      en.target.style.transition = \"opacity 1s ease, transform 1s ease\";\n      if (en.isIntersecting) { en.target.style.opacity = 1; en.target.style.transform = \"none\"; }\n    }), { threshold: 0.2 });\n    document.querySelectorAll(\".prod, .quote\").forEach(el => {\n      el.style.opacity = 0; el.style.transform = \"translateY(16px)\";\n      io.observe(el);\n    });\n  \u003c/script>\n\u003c/body>\n\u003c/html>\n"}}