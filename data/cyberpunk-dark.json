ht: 300px; white-space: pre-wrap; word-break: break-word; }\n  .cursor { display: inline-block; width: 9px; height: 17px; background: #00ff9c; vertical-align: -3px; animation: blink 0.9s steps(1) infinite; }\n\n  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 22px; }\n  .mod { border: 1px solid #0e3d29; padding: 18px; background: rgba(0, 255, 156, 0.02); position: relative; transition: all 0.25s; }\n  .mod::before, .mod::after { content: \"\"; position: absolute; width: 14px; height: 14px; border: 2px solid #00ff9c; }\n  .mod::before { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }\n  .mod::after { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }\n  .mod:hover { border-color: #00ff9c; box-shadow: 0 0 24px rgba(0, 255, 156, 0.18); }\n  .mod .k { font-size: 10.5px; letter-spacing: 0.24em; color: #5da886; text-transform: uppercase; }\n  .mod .v { font-size: 27px; color: #00ff9c; margin: 8px 0 4px; text-shadow: 0 0 14px rgba(0, 255, 156, 0.5); }\n  .mod.mag .v { color: #ff2bd6; text-shadow: 0 0 14px rgba(255, 43, 214, 0.5); }\n  .mod .s { font-size: 11.5px; color: #4c7a63; }\n\n  h1 { font-size: 20px; letter-spacing: 0.3em; color: #00ff9c; text-align: center; margin: 34px 0 6px; text-shadow: 0 0 22px rgba(0, 255, 156, 0.55); }\n  .sub { text-align: center; font-size: 11.5px; letter-spacing: 0.28em; color: #5da886; margin-bottom: 26px; }\n  .sub .m { color: #ff2bd6; }\n\n  @media (max-width: 640px) { .grid3 { grid-template-columns: 1fr; } }\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003cdiv class=\"wrap\">\n    \u003cdiv class=\"hud\">\n      \u003cspan>NEXUS_OS v2.77 \u003cspan class=\"blink\">▮\u003c/span>\u003c/span>\n      \u003cspan>UPLINK: \u003cb style=\"color:#00ff9c\">STABLE\u003c/b>\u003c/span>\n      \u003cspan class=\"m\">SECTOR-7 // NIGHT MODE\u003c/span>\n    \u003c/div>\n\n    \u003ch1>NEXUS//TERMINAL\u003c/h1>\n    \u003cdiv class=\"sub\">AI OPERATIONS CONSOLE — \u003cspan class=\"m\">AUTHORIZED PERSONNEL ONLY\u003c/span>\u003c/div>\n\n    \u003cdiv class=\"term\">\n      \u003cdiv class=\"term-head\">\u003cspan class=\"dots\">\u003ci>\u003c/i>\u003ci>\u003c/i>\u003ci>\u003c/i>\u003c/span> root@nexus: ~/ops\u003c/div>\n      \u003cdiv class=\"term-body\" id=\"term\">\u003cspan class=\"cursor\">\u003c/span>\u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"grid3\">\n      \u003cdiv class=\"mod\">\u003cdiv class=\"k\">Neural load\u003c/div>\u003cdiv class=\"v\" data-n=\"87.2\">0\u003c/div>\u003cdiv class=\"s\">% of cluster capacity\u003c/div>\u003c/div>\n      \u003cdiv class=\"mod mag\">\u003cdiv class=\"k\">Threats blocked\u003c/div>\u003cdiv class=\"v\" data-n=\"1337\">0\u003c/div>\u003cdiv class=\"s\">last 24 hours\u003c/div>\u003c/div>\n      \u003cdiv class=\"mod\">\u003cdiv class=\"k\">Uptime\u003c/div>\u003cdiv class=\"v\" data-n=\"99.99\">0\u003c/div>\u003cdiv class=\"s\">% — 447 days streak\u003c/div>\u003c/div>\n    \u003c/div>\n  \u003c/div>\n\n  \u003cscript>\n    // self-typing boot sequence\n    const el = document.getElementById('term');\n    const script = [\n      ['$ nexus boot --sector 7', 'g'],\n      ['[ok] neural core ......... ONLINE', 'dim'],\n      ['[ok] uplink to grid ...... STABLE', 'dim'],\n      ['[ok] threat lattice ...... ARMED', 'dim'],\n      ['', ''],\n      ['$ nexus run infiltrate --target vault_77', 'g'],\n      ['> bypassing ICE layer ....... done', 'dim'],\n      ['> spoofing signature ........ done', 'dim'],\n      ['> downloading payload ....... 4.2 TB', 'dim'],\n      ['', ''],\n      ['ACCESS GRANTED. welcome back, operator.', 'ok']\n    ];\n    const cls = { g: 'color:#00ff9c', dim: 'color:#5da886', ok: 'color:#ff2bd6;font-weight:bold' };\n    let li = 0, ci = 0;\n    const cursor = () => '\u003cspan class=\"cursor\">\u003c/span>';\n    function render(lines) { el.innerHTML = lines.map(l => l.t ? `\u003cspan style=\"${cls[l.c] || ''}\">${l.t}\u003c/span>` : '&nbsp;').join('\\n') + '\\n' + cursor(); }\n    const lines = [];\n    (function type() {\n      if (li >= script.length) { render(lines); return; }\n      const [text, c] = script[li];\n      ci++;\n      lines[li] = { t: text.slice(0, ci), c };\n      render(lines);\n      if (ci >= text.length) { li++; ci = 0; setTimeout(type, text ? 180 : 60); }\n      else setTimeout(type, text[ci - 1] === ' ' ? 12 : 34);\n    })();\n\n    // count-up modules\n    document.querySelectorAll('[data-n]').forEach(el2 => {\n      const target = parseFloat(el2.dataset.n), dec = target % 1 ? 2 : 0;\n      let p = 0; const t0 = performance.now();\n      (function tick(t) {\n        p = Math.min((t - t0 - 3200) / 1600, 1); // start after typing\n        if (p > 0) el2.textContent = (target * (1 - Math.pow(1 - p, 3))).toFixed(dec);\n        if (p \u003c 1) requestAnimationFrame(tick);\n      })(performance.now());\n    });\n  \u003c/script>\n\u003c/body>\n\u003c/html>\n"}}