adow: 5px 5px 0 #111; }\n  .cu:nth-child(1) { background: #ffd740; } .cu:nth-child(2) { background: #40c4ff; }\n  .cu:nth-child(3) { background: #ff4081; color: #fff; } .cu:nth-child(4) { background: #69f0ae; }\n  .cu .n { font-size: 34px; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }\n  .cu .l { font-size: 10.5px; font-weight: 800; letter-spacing: 0.16em; margin-top: 4px; }\n\n  .lineup { margin: 44px auto 8px; max-width: 620px; }\n  .lineup h2 { text-align: center; font-size: 15px; letter-spacing: 0.3em; font-weight: 900; margin-bottom: 16px; }\n  .act { display: flex; justify-content: space-between; align-items: center; gap: 10px; border: 3px solid #111; border-radius: 12px; padding: 12px 16px; margin-bottom: 10px; font-weight: 800; font-size: 15px; background: #fff; transition: transform 0.15s; cursor: default; }\n  .act:hover { transform: translate(-3px, -3px) rotate(-0.6deg); box-shadow: 5px 5px 0 #111; }\n  .act:nth-child(1) { background: #ff5252; color: #fff; } .act:nth-child(2) { background: #40c4ff; }\n  .act:nth-child(3) { background: #ffd740; } .act:nth-child(4) { background: #69f0ae; } .act:nth-child(5) { background: #ff4081; color: #fff; }\n  .act .tm { font-size: 12px; font-weight: 700; }\n\n  .tickets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }\n  .tk { border: 3px solid #111; border-radius: 14px; padding: 20px 18px; text-align: center; box-shadow: 6px 6px 0 #111; background: #fff; }\n  .tk.hot { background: #ffd740; transform: rotate(-1.5deg); }\n  .tk .tier { font-size: 11px; font-weight: 900; letter-spacing: 0.2em; }\n  .tk .price { font-size: 32px; font-weight: 900; margin: 6px 0 2px; }\n  .tk .per { font-size: 11px; color: #444; }\n  .tk ul { list-style: none; margin: 12px 0 14px; font-size: 12px; font-weight: 600; }\n  .tk li { padding: 3px 0; }\n  .tk li::before { content: \"★ \"; }\n  .tk button { border: 3px solid #111; background: #111; color: #fff; font: inherit; font-weight: 800; font-size: 12px; padding: 8px 18px; border-radius: 8px; cursor: pointer; }\n  .tk button:hover { background: #ff5252; }\n  .tk .soldout { color: #c62828; font-weight: 900; font-size: 12px; letter-spacing: 0.14em; }\n\n  footer { text-align: center; padding-top: 40px; font-weight: 800; font-size: 12px; letter-spacing: 0.18em; }\n  .zig-f { height: 16px; max-width: 920px; margin: 0 auto 12px; background: repeating-linear-gradient(135deg, #ff5252 0 12px, #40c4ff 12px 24px, #ffd740 24px 36px, #69f0ae 36px 48px); border-top: 3px solid #111; border-bottom: 3px solid #111; }\n\n  @media (max-width: 700px) { .tickets { grid-template-columns: 1fr; } .deco { display: none; } }\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003cdiv class=\"wrap\">\n    \u003cdiv class=\"deco dots\">\u003c/div>\u003cdiv class=\"deco dots2\">\u003c/div>\u003cdiv class=\"deco zig\">\u003c/div>\n    \u003cdiv class=\"deco squig\">\u003c/div>\u003cdiv class=\"deco tri\">\u003c/div>\u003cdiv class=\"deco half\">\u003c/div>\u003cdiv class=\"deco circle\">\u003c/div>\n\n    \u003cdiv class=\"top\">\n      \u003cspan class=\"kick\">ONE WEEKEND · 12 STAGES · ZERO BORING BITS\u003c/span>\n      \u003ch1>POP FEST\u003c/h1>\n      \u003cdiv class=\"year\">'26 EDITION\u003c/div>\n      \u003cdiv class=\"info\">\n        \u003cspan class=\"chip r\">📅 31 DEC 2026\u003c/span>\n        \u003cspan class=\"chip b\">📍 Stadium Merdeka, KL\u003c/span>\n        \u003cspan class=\"chip g\">🎶 40+ artists\u003c/span>\n      \u003c/div>\n\n      \u003cdiv class=\"count\" id=\"count\">\n        \u003cdiv class=\"cu\">\u003cdiv class=\"n\" id=\"d\">00\u003c/div>\u003cdiv class=\"l\">DAYS\u003c/div>\u003c/div>\n        \u003cdiv class=\"cu\">\u003cdiv class=\"n\" id=\"h\">00\u003c/div>\u003cdiv class=\"l\">HOURS\u003c/div>\u003c/div>\n        \u003cdiv class=\"cu\">\u003cdiv class=\"n\" id=\"m\">00\u003c/div>\u003cdiv class=\"l\">MINS\u003c/div>\u003c/div>\n        \u003cdiv class=\"cu\">\u003cdiv class=\"n\" id=\"s\">00\u003c/div>\u003cdiv class=\"l\">SECS\u003c/div>\u003c/div>\n      \u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"lineup\">\n      \u003ch2>★ THE LINEUP ★\u003c/h2>\n      \u003cdiv class=\"act\">\u003cspan>THE PAPER PLANES\u003c/span>\u003cspan class=\"tm\">9:00 PM · Main\u003c/span>\u003c/div>\n      \u003cdiv class=\"act\">\u003cspan>KRUNCH KOLLEKTIVE\u003c/span>\u003cspan class=\"tm\">8:00 PM · East\u003c/span>\u003c/div>\n      \u003cdiv class=\"act\">\u003cspan>MATA HARI & THE MOON\u003c/span>\u003cspan class=\"tm\">7:00 PM · West\u003c/span>\u003c/div>\n      \u003cdiv class=\"act\">\u003cspan>DJ GULA MELAKA\u003c/span>\u003cspan class=\"tm\">6:00 PM · Tent\u003c/span>\u003c/div>\n      \u003cdiv class=\"act\">\u003cspan>PERCUSSION PANAS\u003c/span>\u003cspan class=\"tm\">5:00 PM · Acoustic\u003c/span>\u003c/div>\n    \u003c/div>\n\n    \u003cdiv class=\"tickets\">\n      \u003cdiv class=\"tk\">\n        \u003cdiv class=\"tier\">DAY PASS\u003c/div>\n        \u003cdiv class=\"price\">RM 149\u003c/div>\u003cdiv class=\"per\">1 day · 1 stage\u003c/div>\n        \u003cul>\u003cli>Main stage access\u003c/li>\u003cli>Food village\u003c/li>\u003c/ul>\n        \u003cbutton>Buy now\u003c/button>\n      \u003c/div>\n      \u003cdiv class=\"tk hot\">\n        \u003cdiv class=\"tier\">FULL WEEKEND ⭐\u003c/div>\n        \u003cdiv class=\"price\">RM 299\u003c/div>\u003cdiv class=\"per\">3 days · all stages\u003c/div>\n        \u003cul>\u003cli>All stages + aftershow\u003c/li>\u003cli>Fast lane entry\u003c/li>\u003cli>Limited edition tee\u003c/li>\u003c/ul>\n        \u003cbutton>Buy now\u003c/button>\n      \u003c/div>\n      \u003cdiv class=\"tk\">\n        \u003cdiv class=\"tier\">VIP BACKSTAGE\u003c/div>\n        \u003cdiv class=\"price\">RM 599\u003c/div>\u003cdiv class=\"per\">everything + more\u003c/div>\n        \u003cul>\u003cli>Backstage tour\u003c/li>\u003cli>Artist meet & greet\u003c/li>\u003c/ul>\n        \u003cbutton>Sold out\u003c/button>\u003cdiv class=\"soldout\" hidden>SOLD OUT\u003c/div>\n      \u003c/div>\n    \u003c/div>\n\n    \u003cfooter>\u003cdiv class=\"zig-f\">\u003c/div>POP FEST '26 · BRING EARPLUGS, LEAVE WITH MEMORIES\u003c/footer>\n  \u003c/div>\n\n  \u003cscript>\n    // live countdown to the festival\n    const target = new Date('2026-12-31T17:00:00+08:00').getTime();\n    const $ = id => document.getElementById(id);\n    function tick() {\n      let diff = Math.max(0, target - Date.now());\n      const d = Math.floor(diff / 864e5); diff -= d * 864e5;\n      const h = Math.floor(diff / 36e5); diff -= h * 36e5;\n      const m = Math.floor(diff / 6e4); diff -= m * 6e4;\n      const s = Math.floor(diff / 1e3);\n      $('d').textContent = String(d).padStart(2, '0');\n      $('h').textContent = String(h).padStart(2, '0');\n      $('m').textContent = String(m).padStart(2, '0');\n      $('s').textContent = String(s).padStart(2, '0');\n    }\n    tick();\n    setInterval(tick, 1000);\n  \u003c/script>\n\u003c/body>\n\u003c/html>\n"}}